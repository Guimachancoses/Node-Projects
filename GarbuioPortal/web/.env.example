# O arquivo .env real não deve ser versionado.
PORT=3000
PROTHEUS_ID_EMPRESA=1
PROTHEUS_BASE_URL=https://seu-ambiente.protheus.cloudtotvs.com.br:porta
PROTHEUS_API_USERNAME=usuario
PROTHEUS_API_PASSWORD=senha
PROTHEUS_DEFAULT_USER_CODE=
PROTHEUS_REQUEST_TIMEOUT_MS=30000
PROTHEUS_PAGE_SIZE=100
PROTHEUS_MAX_PAGES=100
SESSION_TTL_MINUTES=480
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
# Use true quando o portal estiver publicado exclusivamente em HTTPS.
SESSION_COOKIE_SECURE=false
