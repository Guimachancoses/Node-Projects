{
  "name": "garbuio-portal-os-web",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:proxy": "ng serve --proxy-config proxy.conf.json",
    "server": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "diagnose:order": "tsx server/diagnose-order.ts",
    "diagnose:search": "tsx server/diagnose-search.ts",
    "dev": "concurrently --kill-others --names BFF,ANGULAR --prefix-colors cyan,magenta \"tsx watch server/index.ts\" \"ng serve --proxy-config proxy.conf.json\"",
    "build": "ng build",
    "build:iis": "ng build --base-href /GarbuioPortal/web/",
    "build:development": "ng build --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:all": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-browser-dynamic": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@po-ui/ng-components": "21.24.0",
    "@po-ui/ng-templates": "21.24.0",
    "@po-ui/style": "21.24.0",
    "@totvs/po-theme": "21.24.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "redux": "^5.0.1",
    "redux-saga": "1.5.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "typed-redux-saga": "1.5.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^21.2.19",
    "@angular-devkit/schematics": "^21.2.19",
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.0",
    "@schematics/angular": "^21.2.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
